# Copy to spike/smb-probe.properties and fill in. That filename is gitignored so the
# password never reaches the repo.
#
# Point this at the SAME share the app is configured to use — the probe writes only into
# a .jcifs-probe/ scratch folder at the share root and removes it when it finishes.

host=192.168.2.200
port=445
share=
path=/
user=
pass=

# Mirror whatever "disable SMB signing" is set to in the app, so the measured latencies
# reflect what the app actually experiences.
signingDisabled=false
