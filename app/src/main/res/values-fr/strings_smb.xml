    <string name="settings_smb_benchmark_result">Listage de %1$d galeries : %2$d ms\n\nFiches de galerie, %3$d à la fois :\n%4$d lues en %5$d ms (%6$s ms chacune)\n\nImages de page, %7$d à la fois :\n%8$d lues en %9$d ms (%10$s Mo/s)</string>
