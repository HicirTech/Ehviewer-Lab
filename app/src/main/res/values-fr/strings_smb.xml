    <string name="settings_smb_benchmark">Mesurer ce partage</string>
    <string name="settings_smb_benchmark_summary">Chronomètre un listage de répertoire, un lot de fiches de galerie et quelques images de page, avec les deux réglages ci-dessus. Lectures uniquement — rien n\'est écrit sur le partage.</string>
