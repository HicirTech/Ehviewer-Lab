<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.hippo.widget.ContentLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- The online list's search set (#185), laid out as in scene_gallery_list.xml. -->
    <com.hippo.ehviewer.widget.SearchLayout
        android:id="@+id/search_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <com.hippo.ehviewer.widget.SearchBar
        android:id="@+id/search_bar"
        style="@style/CardView.Normal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/gallery_search_bar_margin_h"
        android:layout_marginTop="@dimen/gallery_search_bar_margin_v"
        android:layout_marginRight="@dimen/gallery_search_bar_margin_h"/>

    <com.hippo.widget.FabLayout
        android:id="@+id/fab_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingRight="@dimen/corner_fab_margin"
        android:paddingBottom="@dimen/corner_fab_margin">

        <!-- Secondary 0: sort -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            style="@style/Widget.Design.FloatingActionButton.Mini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:backgroundTint="?attr/widgetColorThemeAccent"
            app:srcCompat="@drawable/ic_twotone_sort_24" />

        <!-- Secondary 1: go to page -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            style="@style/Widget.Design.FloatingActionButton.Mini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:backgroundTint="?attr/widgetColorThemeAccent"
            app:srcCompat="@drawable/v_go_to_dark_x24" />

        <!-- Secondary 2: refresh -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            style="@style/Widget.Design.FloatingActionButton.Mini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:backgroundTint="?attr/widgetColorThemeAccent"
            app:srcCompat="@drawable/v_refresh_dark_x24" />

        <!-- Secondary 3: re-sync the selected galleries. Selection mode only. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            style="@style/Widget.Design.FloatingActionButton.Mini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:backgroundTint="?attr/widgetColorThemeAccent"
            app:srcCompat="@drawable/v_refresh_dark_x24" />

        <!-- Secondary 4: delete the selected galleries. Selection mode only. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            style="@style/Widget.Design.FloatingActionButton.Mini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:backgroundTint="?attr/widgetColorThemeAccent"
            app:srcCompat="@drawable/v_delete_dark_x24" />

        <!-- Secondary 5: select all / none. Selection mode only. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            style="@style/Widget.Design.FloatingActionButton.Mini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:backgroundTint="?attr/widgetColorThemeAccent"
            app:srcCompat="@drawable/v_check_all_dark_x24" />

        <!-- Primary. The style is not optional: without it this falls back to the theme's
             Widget.MaterialComponents.FloatingActionButton, and this one button ends up with a
             different elevation and corner from every other primary FAB in the app (#74). -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            style="@style/Widget.Design.FloatingActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:backgroundTint="?attr/widgetColorThemePrimary"
            app:srcCompat="@drawable/v_dots_vertical_secondary_dark_x24" />

    </com.hippo.widget.FabLayout>

    <com.hippo.widget.FabLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingRight="@dimen/corner_fab_margin"
        android:paddingBottom="@dimen/corner_fab_margin">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/search_fab"
            style="@style/Widget.Design.FloatingActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            android:scaleX="0"
            android:scaleY="0"
            app:backgroundTint="?attr/widgetColorThemeAccent"
            app:srcCompat="@drawable/v_magnify_dark_x24" />

    </com.hippo.widget.FabLayout>

</FrameLayout>
