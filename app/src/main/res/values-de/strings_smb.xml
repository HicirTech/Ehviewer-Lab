    <string name="settings_smb_enable_auto_download">Automatisch auf Netzwerkspeicher herunterladen</string>
    <string name="settings_smb_enable_auto_download_summary">Wenn aktiviert, stellt das Öffnen der ersten Seite einer Galerie automatisch einen Hintergrund-Download auf den Netzwerkspeicher in die Warteschlange. Wenn deaktiviert, fragt der Download-Button jedes Mal nach.</string>
    <string name="settings_smb_device_name">Name dieses Geräts</string>
    <string name="settings_smb_device_name_summary">Wird deinen anderen Geräten neben den Galerien angezeigt, die dieses Gerät herunterlädt. Standard ist der Modellname.</string>
